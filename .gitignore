# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
.env

# IDE / editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# MCP server config (local/machine-specific)
.mcp.json

# NX Open MCP server, extracted from NX_Open_MCP.zip by setup.bat
MCP/
MCP_extract_tmp/

# Output from Windows-Tools/Check-UGII-PythonPath
*UGII_PYTHONPATH-*.txt
*Environment-report-*.txt

# Script output (e.g. NX-Scripts/List-Assembly-Components)
output/

# Personal NX scripts (my_scripts) -- not shared
my_scripts/**/*.py

# Archived scripts (NX-Scripts/ARCHIVE) -- local only
NX-Scripts/ARCHIVE/

# Personal Claude Code settings (permissions allowlist) -- local only, never shared
.claude/settings.local.json
